# AI settings for the AIDP-FAB root-cause assistant (rca_assistant.py).
# Copy this file to ai.env and fill in your own values. Never commit ai.env.

# ---- IBM watsonx.ai on Cloud Pak for Data ----
export WATSONX_URL="https://<your-cpd-host>"
export WATSONX_PROJECT_ID="<your-project-id>"
export WATSONX_USERNAME="<your-username>"
export WATSONX_API_KEY="<your-api-key>"
export WATSONX_MODEL="openai/gpt-oss-120b"
# Set to false only if the cluster uses a self-signed certificate
export WATSONX_VERIFY_SSL="true"

# ---- or Claude ----
# export ANTHROPIC_API_KEY="sk-ant-..."

# ---- or a local Ollama model ----
# export OLLAMA_MODEL="llama3.2"

# Force one provider: watsonx | claude | ollama | template
# export AI_PROVIDER="watsonx"
